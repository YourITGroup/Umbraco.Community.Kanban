<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Umbraco.Community.Kanban.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The backoffice serves its own pre-compressed assets; letting dotnet compress them again breaks them. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="Umbraco.Community.Contentment" />
    <PackageReference Include="uSync" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Project references rather than package references, so a change to the package shows up here on
      the next build. The Kanban project contributes its Vite output as a static web asset.
    -->
    <ProjectReference Include="..\..\src\Umbraco.Community.Kanban\Umbraco.Community.Kanban.csproj" />
    <ProjectReference Include="..\..\src\Umbraco.Community.Kanban.Contentment\Umbraco.Community.Kanban.Contentment.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly. -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <Target Name="WarnWhenKanbanClientIsNotBuilt" BeforeTargets="Build" Condition="!Exists('$(MSBuildThisFileDirectory)..\..\src\Umbraco.Community.Kanban\wwwroot\App_Plugins\UmbracoCommunityKanban\umbraco-community-kanban.js')">
    <Warning Text="The Kanban backoffice bundle has not been built, so the sample site will start without any Kanban UI. Run 'npm ci &amp;&amp; npm run build' in src/Umbraco.Community.Kanban/Client first." />
  </Target>
</Project>
