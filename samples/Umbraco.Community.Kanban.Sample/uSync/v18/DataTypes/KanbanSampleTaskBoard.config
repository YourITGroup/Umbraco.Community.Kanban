<?xml version="1.0" encoding="utf-8"?>
<DataType Key="a1000000-0000-4000-8000-000000000003" Alias="Kanban Sample - Task Board" Level="1">
  <Info>
    <Name>Kanban Sample - Task Board</Name>
    <EditorAlias>Umbraco.Community.Kanban.Board</EditorAlias>
    <EditorUIAlias>Umb.Community.Kanban.PropertyEditorUi.Board</EditorUIAlias>
  </Info>
  <Config><![CDATA[{
  "allowDrag": true,
  "cardProperties": [
    {
      "alias": "assignee",
      "header": "Assignee",
      "isSystem": 0
    },
    {
      "alias": "startDate",
      "header": "Starts",
      "isSystem": 0
    },
    {
      "alias": "updateDate",
      "header": "Last edited",
      "isSystem": 1
    }
  ],
  "childItemsSortBy": "name",
  "childItemsSortDirection": "asc",
  "laneContentTypeKey": "a2000000-0000-4000-8000-000000000004",
  "laneOverrides": [
    {
      "value": "In Progress",
      "colour": "blue",
      "icon": "icon-sync"
    },
    {
      "value": "In Review",
      "colour": "orange",
      "icon": "icon-eye"
    },
    {
      "value": "Blocked",
      "colour": "red",
      "icon": "icon-alert"
    },
    {
      "value": "Done",
      "colour": "green",
      "icon": "icon-check"
    }
  ],
  "lanePageSize": 25,
  "laneProperty": "status",
  "showChildItems": true
}]]></Config>
</DataType>